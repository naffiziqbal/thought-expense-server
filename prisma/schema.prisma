// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String
  name           String?
  profilePicture String?   // Stored as /projectName/imageurl.type (CDN base in env)
  currency       String    @default("USD")
  isPremium      Boolean   @default(false)
  premiumSince   DateTime?
  premiumUntil          DateTime?
  subscriptionStatus    String?   // active | cancelled | grace | expired
  subscriptionProductId String?
  subscriptionStore     String?   // play_store | app_store | promo
  pushEnabled           Boolean   @default(true)
  budgetAlertsEnabled   Boolean   @default(true)
  tokenVersion          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  expenses         Expense[]
  insights         Insight[]
  categoryMappings CategoryMapping[]
  budgets          Budget[]
  categoryBudgets  CategoryBudget[]
  goals            Goal[]
  deviceTokens     DeviceToken[]
  recurringRules   RecurringRule[]

  @@index([email])
}

/// Expo push token for one installed app (a user may have several devices).
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   @default("android") // ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A user-confirmed repeating expense that the cron worker logs automatically.
model RecurringRule {
  id          String    @id @default(uuid())
  userId      String
  description String
  amount      Float
  currency    String    @default("USD")
  category    String
  frequency   String    @default("monthly") // weekly | monthly
  dayOfMonth  Int?      // 1-31, monthly rules
  dayOfWeek   Int?      // 0-6 (Sun-Sat), weekly rules
  nextRunAt   DateTime
  lastRunAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([isActive, nextRunAt])
}

model Goal {
  id           String    @id @default(uuid())
  userId       String
  name         String
  targetAmount Float
  savedAmount  Float     @default(0)
  currency     String    @default("USD")
  deadline     DateTime?
  status       String    @default("active") // active | completed | archived
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Expense {
  id          String   @id @default(uuid())
  userId      String
  description String
  amount      Float
  currency    String   @default("USD")
  category    String
  confidence  Float    @default(0.0)
  rawInput    String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vector Vector?

  @@index([userId, date])
  @@index([userId, category])
  @@index([date])
}

model Vector {
  id         String   @id @default(uuid())
  expenseId  String   @unique
  vectorId   String   // Pinecone vector ID
  metadata   Json?    // Store additional metadata
  createdAt  DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model CategoryMapping {
  id          String   @id @default(uuid())
  userId      String
  keyword     String
  category    String
  confidence  Float    @default(1.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword, category])
  @@index([userId])
}

model Insight {
  id        String   @id @default(uuid())
  userId    String
  type      String   // 'weekly', 'monthly', 'trend', 'briefing'
  content   String
  metadata  Json?    // Store structured data like percentages, categories
  period    DateTime // The period this insight is for
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, period])
  @@index([userId, type])
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  month      Int
  year       Int
  totalLimit Float
  /// Currency the limit was entered in, so it can be converted when the user
  /// switches currency. Null on rows written before this was tracked; those are
  /// read as already being in the user's current currency.
  currency   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId, year, month])
}

model CategoryBudget {
  id        String   @id @default(uuid())
  userId    String
  month     Int
  year      Int
  category  String
  limit     Float
  /// See Budget.currency.
  currency  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year, category])
  @@index([userId, year, month, category])
}

// Predefined categories
enum Category {
  FOOD
  TRANSPORT
  RENT
  UTILITIES
  SHOPPING
  ENTERTAINMENT
  HEALTHCARE
  EDUCATION
  PERSONAL_CARE
  FEES
  OTHER
}
