// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password              String
  name                  String?
  profilePicture        String? // Stored as /projectName/imageurl.type (CDN base in env)
  currency              String    @default("USD")
  isPremium             Boolean   @default(false)
  premiumSince          DateTime?
  premiumUntil          DateTime?
  subscriptionStatus    String? // active | cancelled | grace | expired
  subscriptionProductId String?
  subscriptionStore     String? // play_store | app_store | promo
  pushEnabled           Boolean   @default(true)
  budgetAlertsEnabled   Boolean   @default(true)
  tokenVersion          Int       @default(0)
  /// Login and API access are refused until the user resets their password by email code
  passwordResetRequired Boolean   @default(false)
  suspendedAt           DateTime?
  bannedAt              DateTime?
  moderationNote        String?
  /// Last authenticated API request (throttled to ~hourly; not bumped by updatedAt)
  lastActiveAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  expenses             Expense[]
  insights             Insight[]
  categoryMappings     CategoryMapping[]
  budgets              Budget[]
  categoryBudgets      CategoryBudget[]
  goals                Goal[]
  deviceTokens         DeviceToken[]
  recurringRules       RecurringRule[]
  billingWebhookEvents BillingWebhookEvent[]

  @@index([email])
}

/// Anonymous record of a deleted account, kept for churn/retention metrics. No email or name.
model DeletedAccount {
  id                    String    @id @default(uuid())
  /// Former User.id (opaque; links to BillingWebhookEvent.appUserId)
  userId                String
  signupAt              DateTime
  deletedAt             DateTime  @default(now())
  reason                String // self_delete
  currency              String?
  wasPremium            Boolean
  subscriptionStatus    String?
  subscriptionProductId String?
  subscriptionStore     String?
  premiumSince          DateTime?
  lastActiveAt          DateTime?
  lastExpenseAt         DateTime?
  expenseCount          Int
  aiCalls               Int       @default(0)
  aiCostUsd             Float     @default(0)

  @@index([deletedAt])
  @@index([signupAt])
}

/// Console operators (separate from app User accounts).
model Admin {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String?
  tokenVersion  Int       @default(0)
  lastLoginAt   DateTime?
  /// Base32 TOTP secret. Set by `pnpm admin:totp`; when present, sign-in needs a code.
  totpSecret    String?
  totpEnabledAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs AdminAuditLog[]
  sessions  AdminSession[]

  @@index([email])
}

/// Admin console login session. Holds the current (hashed) rotating refresh token.
model AdminSession {
  id            String    @id @default(uuid())
  adminId       String
  admin         Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// sha256 of the current refresh token
  tokenHash     String    @unique
  /// sha256 of the refresh token it replaced — presenting it again means the token leaked
  prevTokenHash String?   @unique
  /// Admin.tokenVersion at login; bumping the admin's version kills the session
  tokenVersion  Int
  expiresAt     DateTime
  lastUsedAt    DateTime  @default(now())
  rotatedAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  @@index([adminId])
}

/// RevenueCat webhook deliveries (for admin billing ops).
model BillingWebhookEvent {
  id              String    @id @default(uuid())
  externalEventId String?
  eventType       String
  appUserId       String?
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId       String?
  store           String?
  outcome         String // processed | duplicate | unmapped | ignored | error
  /// Revenue fields from the RevenueCat event (null on duplicates and pre-capture rows)
  priceUsd        Float? // negative for refunds
  priceLocal      Float?
  currency        String?
  periodType      String? // TRIAL | INTRO | NORMAL | PROMOTIONAL | PREPAID
  purchasedAt     DateTime?
  expiresAt       DateTime?
  cancelReason    String? // also holds expiration_reason on EXPIRATION
  environment     String? // SANDBOX | PRODUCTION
  countryCode     String?
  transactionId   String?
  /// Raw event (subscriber_attributes stripped) so future metrics can be backfilled
  payload         Json?
  createdAt       DateTime  @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([externalEventId])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String // user | admin | system
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}

/// Expo push token for one installed app (a user may have several devices).
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   @default("android") // ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A user-confirmed repeating expense that the cron worker logs automatically.
model RecurringRule {
  id          String    @id @default(uuid())
  userId      String
  description String
  amount      Float
  currency    String    @default("USD")
  category    String
  frequency   String    @default("monthly") // weekly | monthly
  dayOfMonth  Int? // 1-31, monthly rules
  dayOfWeek   Int? // 0-6 (Sun-Sat), weekly rules
  nextRunAt   DateTime
  lastRunAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([isActive, nextRunAt])
}

model Goal {
  id           String    @id @default(uuid())
  userId       String
  name         String
  targetAmount Float
  savedAmount  Float     @default(0)
  currency     String    @default("USD")
  deadline     DateTime?
  status       String    @default("active") // active | completed | archived
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Expense {
  id          String   @id @default(uuid())
  userId      String
  description String
  amount      Float
  currency    String   @default("USD")
  category    String
  confidence  Float    @default(0.0)
  rawInput    String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vector Vector?

  @@index([userId, date])
  @@index([userId, category])
  @@index([date])
}

model Vector {
  id        String   @id @default(uuid())
  expenseId String   @unique
  vectorId  String // Pinecone vector ID
  metadata  Json? // Store additional metadata
  createdAt DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model CategoryMapping {
  id         String   @id @default(uuid())
  userId     String
  keyword    String
  category   String
  confidence Float    @default(1.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword, category])
  @@index([userId])
}

model Insight {
  id        String   @id @default(uuid())
  userId    String
  type      String // 'weekly', 'monthly', 'trend', 'briefing'
  content   String
  metadata  Json? // Store structured data like percentages, categories
  period    DateTime // The period this insight is for
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, period])
  @@index([userId, type])
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  month      Int
  year       Int
  totalLimit Float
  /// Currency the limit was entered in, so it can be converted when the user
  /// switches currency. Null on rows written before this was tracked; those are
  /// read as already being in the user's current currency.
  currency   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId, year, month])
}

model CategoryBudget {
  id        String   @id @default(uuid())
  userId    String
  month     Int
  year      Int
  category  String
  limit     Float
  /// See Budget.currency.
  currency  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year, category])
  @@index([userId, year, month, category])
}

// Predefined categories
enum Category {
  FOOD
  TRANSPORT
  RENT
  UTILITIES
  SHOPPING
  ENTERTAINMENT
  HEALTHCARE
  EDUCATION
  PERSONAL_CARE
  FEES
  OTHER
}
