{
  "name": "thoughtexpense-backend",
  "version": "1.0.0",
  "description": "Backend API for ThoughtExpense - Natural language expense tracker",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "backup": "./scripts/backup-db.sh",
    "backup:list": "node scripts/spaces-backup.js list",
    "backup:prune": "node scripts/spaces-backup.js prune --dry-run",
    "backup:restore": "./scripts/restore-db.sh",
    "sync-catalog-db": "ts-node -r dotenv/config src/scripts/syncExpenseCatalogToProduction.ts",
    "sync-catalog-db:apply": "ts-node -r dotenv/config src/scripts/syncExpenseCatalogToProduction.ts --apply"
  },
  "keywords": [
    "expense",
    "tracker",
    "ai",
    "nlp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.987.0",
    "@google/generative-ai": "^0.24.1",
    "@pinecone-database/pinecone": "^2.0.1",
    "@prisma/client": "^5.8.0",
    "@sentry/node": "^10.74.0",
    "@sentry/profiling-node": "^10.74.0",
    "@types/pdfkit": "^0.17.4",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.58.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "openai": "^4.24.1",
    "pdfkit": "^0.17.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "4.2.0",
    "redis": "^4.6.12",
    "resend": "^6.9.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "nodemon": "^3.0.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/node-cpu-profiler"
    ]
  }
}
