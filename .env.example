# Server Configuration
PORT=7100
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL="postgresql://thoughtexpense:password@localhost:5432/thoughtexpense?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Resend (Email)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=ThoughtExpense <onboarding@resend.dev>
APP_NAME=ThoughtExpense

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000

# Gemini (Google AI)
GEMINI_API_KEY=your-gemini-api-key

# Pinecone (vector search for similar expenses + NL search)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=thoughtexpense-embeddings
# Used only if the named index does not exist yet
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Only set true if you intentionally want a missing name to create a new empty index
PINECONE_CREATE_INDEX=false

# DigitalOcean Spaces (S3-compatible)
SPACES_ACCESS_KEY=""
SPACES_SECRET_KEY=
SPACES_BUCKET=
SPACES_REGION=
SPACES_ENDPOINT=
STORAGE_PROJECT_NAME=

# Database backups (scripts/backup-db.sh)
# Private Spaces bucket for dumps. Must NOT be the bucket that serves avatars
# publicly — dumps contain emails, password hashes and all financial data.
BACKUP_SPACES_BUCKET=
BACKUP_SPACES_PREFIX=thoughtexpense/db
# Prefer a key scoped to the backup bucket. Falls back to SPACES_ACCESS_KEY /
# SPACES_SECRET_KEY when unset.
BACKUP_SPACES_ACCESS_KEY=
BACKUP_SPACES_SECRET_KEY=
# Region-only endpoint, e.g. https://sgp1.digitaloceanspaces.com.
# Do not reuse SPACES_ENDPOINT, which may carry the avatar bucket's hostname.
BACKUP_SPACES_ENDPOINT=
BACKUP_SPACES_REGION=sgp1
# Retention: every dump from the last N days, then one per month for M months.
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MONTHS=12
# Days of dumps to keep on the server's own disk.
LOCAL_RETENTION_DAYS=7
# Optional dead-man's switch (healthchecks.io, Better Stack, ...). Pinged on
# success; "<url>/fail" is pinged on failure.
BACKUP_HEALTHCHECK_URL=

# AI Configuration
# Text models (2026): gemini-flash-latest, gemini-pro-latest, gemini-3-flash-preview, gemini-3-pro-preview
# Embedding model: gemini-embedding-001 (official model for @google/generative-ai package)
PARSING_MODEL=gemini-flash-latest
INSIGHTS_MODEL=gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7

# RevenueCat (Google Play subscriptions)
# Set the same value as the webhook Authorization header in the RevenueCat dashboard
REVENUECAT_WEBHOOK_AUTH=
# Secret API key (Project settings) — used by admin ops to compare DB premium vs entitlements
REVENUECAT_SECRET_API_KEY=
# Entitlement identifier to check (default: premium)
REVENUECAT_ENTITLEMENT_ID=premium

# Admin console JWT lifetime (optional; default 12h). Create accounts with: pnpm admin:create
ADMIN_JWT_EXPIRES_IN=12h

# Sentry (errors + tracing). Leave empty to disable.
SENTRY_DSN=

# Weekly Financial Briefing schedule (cron, server time). Default: Mondays 08:00
BRIEFING_CRON=0 8 * * 1